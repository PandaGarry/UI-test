language = "nodejs"

run = "npm start"

entrypoint = "scripts/serve.js"

modules = ["nodejs-24"]

[nix]

channel = "stable-24_05"

[[ports]]

localPort = 8080

externalPort = 80

[workflows]

runButton = "Project"

[[workflows.workflow]]

name = "Project"

mode = "parallel"

author = "agent"

[[workflows.workflow.tasks]]

task = "workflow.run"

args = "UI-test"

[[workflows.workflow]]

name = "UI-test"

author = "agent"

[[workflows.workflow.tasks]]

task = "shell.exec"

args = "npm start"

waitForPort = 8080

[workflows.workflow.metadata]

outputType = "webview"
